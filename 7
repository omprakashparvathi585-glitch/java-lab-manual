import java.io.*;
import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        String filename = "students.txt";

        try {

            BufferedWriter writer = new BufferedWriter(new FileWriter(filename));

            System.out.println("Enter Details of 3 Students\n");

            for (int i = 1; i <= 3; i++) {

                System.out.println("Student " + i);

                System.out.print("Roll No : ");
                String roll = sc.nextLine();

                System.out.print("Name : ");
                String name = sc.nextLine();

                System.out.print("Marks : ");
                String marks = sc.nextLine();

                System.out.println();

                writer.write(roll + "," + name + "," + marks);
                writer.newLine();
            }

            writer.close();

            System.out.println("Student records saved successfully.");

            System.out.println("\n----- Student Records -----");

            BufferedReader br1 = new BufferedReader(new FileReader(filename));

            String line;

            while ((line = br1.readLine()) != null) {
                System.out.println(line);
            }

            br1.close();

            System.out.print("\nEnter Roll Number to Search : ");
            String searchRoll = sc.nextLine();

            BufferedReader br2 = new BufferedReader(new FileReader(filename));

            boolean found = false;

            while ((line = br2.readLine()) != null) {

                String[] parts = line.split(",");

                if (parts[0].trim().equals(searchRoll.trim())) {

                    found = true;

                    System.out.println("\nStudent Found");
                    System.out.println("Roll No : " + parts[0]);
                    System.out.println("Name : " + parts[1]);
                    System.out.println("Marks : " + parts[2]);

                    break;
                }
            }

            if (!found) {
                System.out.println("\nStudent Not Found");
            }

            br2.close();

        } catch (IOException e) {

            System.out.println("Error : " + e.getMessage());

        } finally {

            sc.close();
        }
    }
}
